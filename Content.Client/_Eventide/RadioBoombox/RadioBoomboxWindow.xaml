<ControlWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Управление Бумбоксом"
               SetSize="(300, 150)">
    <BoxContainer Orientation="Vertical" Margin="10">
        <BoxContainer Orientation="Horizontal" Align="Center">
            <Button Name="PlayButton" Text="▶" MinSize="(40, 40)" />
            <Button Name="AddUrlButton" Text="+" MinSize="(40, 40)" Margin="5,0,0,0" />
        </BoxContainer>
        <BoxContainer Name="UrlContainer" Orientation="Vertical" Visible="False" Margin="0,10,0,0">
            <LineEdit Name="UrlInput" PlaceHolder="Вставьте ссылку..." />
            <BoxContainer Orientation="Horizontal" Margin="0,5,0,0">
                <Button Name="ConfirmButton" Text="ОК" HorizontalExpand="True" />
                <Button Name="CancelButton" Text="Отмена" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</ControlWindow>
